+.documentation-menu-panel a,
+.research-menu-panel a { min-width: 0; }
+.documentation-menu-panel span,
+.documentation-menu-panel small,
+.research-menu-panel span,
+.research-menu-panel small { overflow-wrap: anywhere; }
+
+.story-grid { max-width: 1260px; display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 18px; margin: 0 auto 28px; }
+.story-card,
+.creator-card,
+.team-placeholder-card,
+.contact-card,
+.social-directory,
+.contact-note,
+.about-cta {
+  border: 1px solid var(--line);
+  border-radius: 18px;
+  background: rgba(10, 25, 22, 0.76);
+}
+.story-card { padding: clamp(22px, 4vw, 38px); }
+.story-card-wide { grid-column: 1 / -1; }
+.story-card h2,
+.profile-heading h2,
+.contact-card h2,
+.about-cta h2 { margin: 7px 0 10px; }
+.story-card p:last-child,
+.profile-heading > p:last-child,
+.contact-card p { color: #c8d9d4; line-height: 1.65; }
+.profile-section { max-width: 1260px; margin: 0 auto 28px; }
+.profile-heading { margin-bottom: 16px; }
+.creator-card { display: grid; grid-template-columns: auto minmax(0, 1fr); align-items: center; gap: 24px; padding: clamp(22px, 4vw, 36px); }
+.creator-card img { filter: drop-shadow(0 12px 28px rgba(189, 252, 107, 0.15)); }
+.creator-card p { margin: 0; line-height: 1.65; }
+.creator-card p + p { margin-top: 10px; color: var(--muted); }
+.team-grid { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 14px; }
+.team-placeholder-card { display: grid; gap: 8px; min-height: 145px; padding: 20px; }
+.team-placeholder-card > span { color: var(--accent); font-family: var(--font-display); font-size: 0.75rem; }
+.team-placeholder-card strong { font-family: var(--font-display); }
+.team-placeholder-card small { color: var(--muted); }
+.about-current-work { max-width: 1260px; display: flex; align-items: center; justify-content: space-between; gap: 24px; margin: 0 auto 28px; }
+.about-current-work > div { max-width: 820px; }
+.about-cta { max-width: 1260px; display: flex; justify-content: space-between; align-items: center; gap: 24px; margin: 0 auto; padding: clamp(22px, 4vw, 36px); }
+
+.paper-status-grid { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 12px; margin: 18px 0 28px; }
+.paper-status-grid article { display: grid; gap: 6px; padding: 16px; border: 1px solid var(--line); border-radius: 12px; background: rgba(7, 18, 16, 0.52); }
+.paper-status-grid span { color: var(--accent); font-family: var(--font-display); font-size: 0.7rem; text-transform: uppercase; letter-spacing: 0.08em; }
+.paper-status-grid small { color: var(--muted); }
+.placeholder-resource-grid { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 10px; margin: 14px 0 24px; }
+.placeholder-resource-grid > span { display: grid; gap: 5px; padding: 14px; border: 1px dashed rgba(189, 252, 107, 0.28); border-radius: 10px; background: rgba(189, 252, 107, 0.035); }
+.placeholder-resource-grid small { color: var(--muted); }
+.info-section-body pre { overflow-x: auto; padding: 16px; border: 1px solid var(--line); border-radius: 12px; background: #07100f; }
+
+.contact-grid { max-width: 1260px; display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 16px; margin: 0 auto 28px; }
+.contact-card { padding: clamp(20px, 3vw, 30px); }
+.contact-card a { color: var(--accent); overflow-wrap: anywhere; }
+.social-directory { max-width: 1260px; margin: 0 auto 28px; padding: clamp(22px, 4vw, 36px); }
+.social-directory-grid { display: grid; grid-template-columns: repeat(4, minmax(0, 1fr)); gap: 12px; }
+.social-directory-grid a { display: grid; gap: 7px; min-width: 0; padding: 16px; border: 1px solid var(--line); border-radius: 12px; color: var(--text); text-decoration: none; background: rgba(7, 18, 16, 0.5); }
+.social-directory-grid a:hover { border-color: rgba(189, 252, 107, 0.45); transform: translateY(-1px); }
+.social-directory-grid small { color: var(--muted); line-height: 1.45; }
+.social-directory-grid span { color: var(--accent); font-size: 0.72rem; overflow-wrap: anywhere; }
+.contact-note { max-width: 1260px; margin: 0 auto; padding: 20px 24px; }
